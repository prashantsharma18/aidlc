{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(/.claude/**)",
      "Edit(/scripts/check_*.py)",
      "Edit(/scripts/run_slices.py)",
      "Edit(/.github/workflows/ai-review.yml)",
      "Edit(/CODEOWNERS)",
      "Edit(/.github/CODEOWNERS)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(pip install*)",
      "Bash(dotnet add package*)"
    ],
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "../stories"
    ],
    "allow": [
      "Read(~/.claude/plugins/cache/aidlc/**)",
      "Read(~/.claude/plugins/marketplaces/aidlc/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.*",
        "~/.ssh",
        "~/.aws"
      ]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_slice.py\" --hook --root \"$CLAUDE_PROJECT_DIR\""}
        ]
      }
    ]
  },
  "enabledPlugins": {
    "aidlc@aidlc": true
  },
  "extraKnownMarketplaces": {
    "aidlc": {
      "source": {
        "source": "github",
        "repo": "prashantsharma18/aidlc"
      }
    }
  }
}
