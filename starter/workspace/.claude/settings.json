{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/stories/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true
  },
  "enabledPlugins": {
    "aidlc@aidlc": true
  },
  "extraKnownMarketplaces": {
    "aidlc": {
      "source": {
        "source": "github",
        "repo": "prashantsharma18/aidlc"
      }
    }
  }
}
