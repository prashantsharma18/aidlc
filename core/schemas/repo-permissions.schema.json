{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-permissions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "strs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "set4": {"type": "object", "additionalProperties": false,
             "properties": {"read": {"$ref": "#/$defs/strs"}, "edit": {"$ref": "#/$defs/strs"},
                            "shell": {"$ref": "#/$defs/strs"}, "tools": {"$ref": "#/$defs/strs"}}}
  },
  "properties": {
    "deny_add": {"$ref": "#/$defs/set4"},
    "ask_add": {"$ref": "#/$defs/set4"},
    "allow_remove": {"$ref": "#/$defs/set4"},
    "secret_paths_add": {"$ref": "#/$defs/strs"},
    "protected_paths_add": {"$ref": "#/$defs/strs"},
    "network_allow_add": {"$ref": "#/$defs/strs"},
    "sandbox_allow_write_add": {"$ref": "#/$defs/strs"},
    "allow_add": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "pattern", "reason", "owner"],
      "properties": {"kind": {"enum": ["read", "edit", "shell", "tools"]},
                     "pattern": {"type": "string", "minLength": 1},
                     "reason": {"type": "string", "minLength": 1},
                     "owner": {"type": "string", "minLength": 1}}}}
  }
}
