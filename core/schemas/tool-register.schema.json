{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-register.schema.json",
  "type": "object",
  "required": [
    "meta",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "owner",
          "purpose",
          "data_flows",
          "route",
          "telemetry",
          "permissions",
          "review_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "pilot",
              "rejected"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          },
          "data_flows": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "telemetry": {
            "type": "string"
          },
          "permissions": {
            "type": "string"
          },
          "review_by": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "kind",
                "url",
                "sha256"
              ],
              "properties": {
                "platform": {
                  "enum": [
                    "linux-x86_64"
                  ]
                },
                "kind": {
                  "enum": [
                    "binary",
                    "tar.gz"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "member": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "tar.gz"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "member"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
