{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-routes.schema.json",
  "type": "object",
  "required": [
    "meta",
    "routes",
    "egress"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "access",
          "max_data_class",
          "used_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "access": {
            "type": "string"
          },
          "max_data_class": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "egress": {
      "type": "string"
    }
  }
}
